{
  "name": "jobscraper",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "clean": "rm -rf server/dist client/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.0"
  }
}
